# Backend-only secrets. Never commit the real .env file.
AI_API_KEY=your_gemini_api_key_here
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Gemini model used by the backend.
# Verify that this model is enabled for your API account.
AI_MODEL=gemini-3.6-flash

# Comma-separated frontend origins.
FRONTEND_ORIGINS=http://localhost:5173,https://ai-learning-path-inky.vercel.app
